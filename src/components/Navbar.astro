---
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<header
	id="site-header"
	class="fixed inset-x-0 top-0 z-50 border-b border-[var(--border)]/60 bg-[var(--bg)]/85 backdrop-blur-md"
>
	<nav class="mx-auto flex h-[72px] max-w-6xl items-center justify-between px-6 md:px-8">
		<!-- Brand -->
		<a
			href={base}
			class="group flex items-center gap-2"
			aria-label="Alan Maulana Fajar - Home"
		>
			<span class="text-sm font-semibold tracking-[-0.02em] text-[var(--text)] transition group-hover:text-[var(--accent)]">
				AMF
			</span>

			<span class="text-[var(--accent)]">.</span>
		</a>

		<!-- Desktop navigation -->
		<div class="hidden items-center gap-7 font-mono text-[11px] uppercase tracking-[0.12em] md:flex">
			<a
				href={`${base}#about`}
				data-nav-link
				data-section="about"
				class="nav-link relative text-[var(--text-dim)] transition hover:text-[var(--text)]"
			>
				About
			</a>

			<a
				href={`${base}#projects`}
				data-nav-link
				data-section="projects"
				class="nav-link relative text-[var(--text-dim)] transition hover:text-[var(--text)]"
			>
				Projects
			</a>

			<a
				href={`${base}#experience`}
				data-nav-link
				data-section="experience"
				class="nav-link relative text-[var(--text-dim)] transition hover:text-[var(--text)]"
			>
				Experience
			</a>

			<a
				href={`${base}#stack`}
				data-nav-link
				data-section="stack"
				class="nav-link relative text-[var(--text-dim)] transition hover:text-[var(--text)]"
			>
				Tech Stack
			</a>

			<a
				href={`${base}#contact`}
				data-nav-link
				data-section="contact"
				class="nav-link relative text-[var(--text-dim)] transition hover:text-[var(--text)]"
			>
				Contact
			</a>
		</div>

		<!-- Desktop CTA -->
		<a
			href={`${base}#contact`}
			class="group hidden items-center gap-2 text-sm text-[var(--text-muted)] transition hover:text-[var(--text)] md:flex"
		>
			<span>Let's Talk</span>

			<span class="text-[var(--accent)] transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
				↗
			</span>
		</a>

		<!-- Mobile menu button -->
		<button
			id="mobile-menu-button"
			type="button"
			class="relative flex h-10 w-10 items-center justify-center text-[var(--text)] md:hidden"
			aria-label="Buka menu navigasi"
			aria-controls="mobile-menu"
			aria-expanded="false"
		>
			<span class="sr-only">Menu</span>

			<span class="hamburger">
				<span></span>
				<span></span>
				<span></span>
			</span>
		</button>
	</nav>

	<!-- Mobile navigation -->
	<div id="mobile-menu" data-open="false" class="mobile-menu md:hidden">
		<div class="mx-auto max-w-6xl border-t border-[var(--border)] px-6 py-7">
			<div class="flex flex-col font-mono text-xs uppercase tracking-[0.14em]">
				<a
					href={`${base}#about`}
					data-nav-link
					data-mobile-link
					data-section="about"
					class="nav-link mobile-nav-link"
				>
					<span>01</span>
					<span>About</span>
				</a>

				<a
					href={`${base}#projects`}
					data-nav-link
					data-mobile-link
					data-section="projects"
					class="nav-link mobile-nav-link"
				>
					<span>02</span>
					<span>Projects</span>
				</a>

				<a
					href={`${base}#experience`}
					data-nav-link
					data-mobile-link
					data-section="experience"
					class="nav-link mobile-nav-link"
				>
					<span>03</span>
					<span>Experience</span>
				</a>

				<a
					href={`${base}#stack`}
					data-nav-link
					data-mobile-link
					data-section="stack"
					class="nav-link mobile-nav-link"
				>
					<span>04</span>
					<span>Tech Stack</span>
				</a>

				<a
					href={`${base}#contact`}
					data-nav-link
					data-mobile-link
					data-section="contact"
					class="nav-link mobile-nav-link"
				>
					<span>05</span>
					<span>Contact</span>
				</a>
			</div>

			<a
				href={`${base}#contact`}
				data-mobile-link
				class="mt-7 inline-flex items-center gap-3 border-b border-[var(--accent)] pb-1 text-sm text-[var(--text)]"
			>
				Let's Talk
				<span class="text-[var(--accent)]">↗</span>
			</a>
		</div>
	</div>
</header>

<script>
	function initNavbar() {
		const menuButton = document.querySelector('#mobile-menu-button');
		const mobileMenu = document.querySelector('#mobile-menu');

		if (
			!(menuButton instanceof HTMLButtonElement) ||
			!(mobileMenu instanceof HTMLElement)
		) {
			return;
		}

		const mobileLinks = document.querySelectorAll('[data-mobile-link]');
		const navLinks = document.querySelectorAll('[data-nav-link]');

		function openMenu() {
			mobileMenu.dataset.open = 'true';
			menuButton.setAttribute('aria-expanded', 'true');
			menuButton.setAttribute('aria-label', 'Tutup menu navigasi');
			menuButton.classList.add('is-open');
		}

		function closeMenu() {
			mobileMenu.dataset.open = 'false';
			menuButton.setAttribute('aria-expanded', 'false');
			menuButton.setAttribute('aria-label', 'Buka menu navigasi');
			menuButton.classList.remove('is-open');
		}

		menuButton.onclick = () => {
			if (mobileMenu.dataset.open === 'true') {
				closeMenu();
			} else {
				openMenu();
			}
		};

		mobileLinks.forEach((link) => {
			link.addEventListener('click', closeMenu);
		});

		window.addEventListener('resize', () => {
			if (window.innerWidth >= 768) {
				closeMenu();
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				closeMenu();
			}
		});

		/* Active section / scroll spy */
		const sectionIds = [
			'hero',
			'about',
			'projects',
			'experience',
			'stack',
			'contact',
		];

		const sections = sectionIds
			.map((id) => document.getElementById(id))
			.filter(Boolean);

		function setActiveSection(id) {
			navLinks.forEach((link) => {
				const section = link.getAttribute('data-section');

				link.classList.toggle('is-active', id !== 'hero' && section === id);
			});
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						setActiveSection(entry.target.id);
					}
				});
			},
			{
				rootMargin: '-35% 0px -55% 0px',
				threshold: 0,
			},
		);

		sections.forEach((section) => {
			if (section) observer.observe(section);
		});
	}

	initNavbar();

	document.addEventListener('astro:page-load', initNavbar);
</script>

<style>
	/* Desktop active navigation */
	.nav-link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: -7px;
		width: 0;
		height: 1px;
		background: var(--accent);
		transition: width 250ms ease;
	}

	.nav-link.is-active {
		color: var(--accent);
	}

	.nav-link.is-active::after {
		width: 100%;
	}

	/* Hamburger */
	.hamburger {
		position: relative;
		display: flex;
		width: 22px;
		height: 16px;
		flex-direction: column;
		justify-content: space-between;
	}

	.hamburger span {
		display: block;
		width: 100%;
		height: 1px;
		background: currentColor;
		transform-origin: center;
		transition:
			transform 250ms ease,
			opacity 200ms ease;
	}

	#mobile-menu-button.is-open .hamburger span:nth-child(1) {
		transform: translateY(7.5px) rotate(45deg);
	}

	#mobile-menu-button.is-open .hamburger span:nth-child(2) {
		opacity: 0;
	}

	#mobile-menu-button.is-open .hamburger span:nth-child(3) {
		transform: translateY(-7.5px) rotate(-45deg);
	}

	/* Mobile panel */
	.mobile-menu {
		position: absolute;
		top: 72px;
		left: 0;
		width: 100%;

		background: rgba(13, 17, 23, 0.96);
		backdrop-filter: blur(14px);

		opacity: 0;
		visibility: hidden;
		transform: translateY(-8px);
		pointer-events: none;

		transition:
			opacity 220ms ease,
			transform 220ms ease,
			visibility 220ms ease;
	}

	.mobile-menu[data-open='true'] {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		pointer-events: auto;
	}

	.mobile-nav-link {
		position: relative;
		display: grid;
		grid-template-columns: 38px 1fr;
		align-items: center;

		padding: 17px 0;

		border-bottom: 1px solid var(--border);

		color: var(--text-dim);

		transition: color 200ms ease;
	}

	.mobile-nav-link:first-child {
		border-top: 1px solid var(--border);
	}

	.mobile-nav-link span:first-child {
		font-size: 9px;
		color: var(--text-dim);
	}

	.mobile-nav-link.is-active {
		color: var(--accent);
	}

	/* Don't use desktop underline on mobile links */
	.mobile-nav-link::after {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-menu,
		.hamburger span,
		.nav-link::after {
			transition: none;
		}
	}
</style>
