---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const asset = (path: string) =>
	`${base}${path.replace(/^\/+/, '')}`;

const technologies = [
	'Laravel',
	'PHP',
	'Blade',
	'Flask',
	'Python',
	'SVM',
	'Tailwind CSS',
];
const repositories = [
	{
		number: '01',
		name: 'Web Application',
		description:
			'Aplikasi web utama yang dikembangkan menggunakan Laravel, Blade, PHP, dan Tailwind CSS untuk mengelola antarmuka serta proses aplikasi.',
		tech: 'Laravel / PHP / Blade / Tailwind CSS',
		url: 'https://github.com/Alanmaulanaf/WebSVM',
	},
	{
		number: '02',
		name: 'Machine Learning API',
		description:
			'Service berbasis Flask dan Python yang menangani proses prediksi kualitas AMDK menggunakan model Support Vector Machine.',
		tech: 'Flask / Python / SVM',
		url: 'https://github.com/Alanmaulanaf/FlaskSVM',
	},
];
---

<Layout
	title="Prediksi Kualitas AMDK — Alan Maulana Fajar"
	description="Aplikasi web prediksi kualitas Air Minum Dalam Kemasan menggunakan algoritma Support Vector Machine."
>
	<Navbar />

	<main>
		<!-- Hero -->
		<section class="mx-auto max-w-6xl px-6 pb-20 pt-36 md:px-8 md:pb-24 md:pt-40">
			<a
				href={`${base}#projects`}
				class="group inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--text-dim)] transition hover:text-[var(--text)]"
			>
				<span class="transition-transform group-hover:-translate-x-1">←</span>
				Back to Projects
			</a>

			<div class="mt-12 grid gap-12 border-t border-[var(--border)] pt-8 md:grid-cols-[1.45fr_0.55fr] md:gap-16">
				<div>
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--accent)]">
						Web Application / Academic Project
					</p>

					<h1 class="mt-5 max-w-4xl text-5xl font-medium tracking-[-0.045em] text-[var(--text)] md:text-7xl">
						Prediksi Kualitas AMDK
					</h1>

					<p class="mt-6 max-w-3xl text-xl leading-8 text-[var(--text-muted)] md:text-2xl">
						Web-Based Water Quality Prediction Using Support Vector Machine.
					</p>
				</div>

				<div class="grid grid-cols-2 gap-x-8 gap-y-7 text-sm md:grid-cols-1">
					<div>
						<p class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--text-dim)]">
							Project Type
						</p>

						<p class="mt-2 text-[var(--text)]">Academic Project</p>
					</div>

					<div>
						<p class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--text-dim)]">
							System
						</p>

						<p class="mt-2 text-[var(--text)]">
							Web / Backend / Machine Learning
						</p>
					</div>

					<div class="col-span-2 md:col-span-1">
						<p class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--text-dim)]">
							Stack
						</p>

						<p class="mt-2 leading-6 text-[var(--text-muted)]">
							Laravel · PHP · Blade · Flask · Python · SVM · Tailwind CSS
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Main Preview -->
		<section class="mx-auto max-w-6xl px-6 pb-24 md:px-8 md:pb-32">
			<div class="overflow-hidden border border-[var(--border)] bg-[var(--surface)]">
				<div class="bg-[var(--surface-soft)] p-5 md:p-8">
					<p class="mb-5 text-center font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--text-dim)]">
						Application Preview
					</p>

					<div class="mx-auto max-w-5xl overflow-hidden border border-[var(--border)] bg-[var(--bg)]">
						<img
							src={asset('images/amdk/dashboard.png')}
							alt="Tampilan aplikasi prediksi kualitas AMDK"
							class="block h-auto w-full object-contain"
						/>
					</div>
				</div>

				<div class="grid gap-8 border-t border-[var(--border)] p-7 md:grid-cols-[1fr_auto] md:p-9">
					<div>
						<p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--accent)]">
							Web Application
						</p>

						<h2 class="mt-4 text-2xl font-medium tracking-[-0.025em] text-[var(--text)] md:text-3xl">
							AMDK Quality Prediction
						</h2>

						<p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--text-muted)]">
							Aplikasi web digunakan untuk melakukan prediksi kualitas Air Minum
							Dalam Kemasan (AMDK) menggunakan model Support Vector Machine.
						</p>
					</div>

					<div>
						<p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--text-dim)]">
							Technology
						</p>

						<div class="mt-4 flex max-w-sm flex-wrap gap-x-3 gap-y-2 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--text-muted)]">
							{technologies.map((technology, index) => (
								<>
									<span>{technology}</span>

									{index < technologies.length - 1 && (
										<span class="text-[var(--border)]">/</span>
									)}
								</>
							))}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Overview -->
		<section class="mx-auto max-w-6xl border-t border-[var(--border)] px-6 py-24 md:px-8 md:py-32">
			<div class="grid gap-12 md:grid-cols-[0.7fr_2fr] md:gap-16">
				<div>
					<div class="flex items-center gap-4">
						<span class="border border-[var(--accent)] px-2.5 py-1 font-mono text-[11px] text-[var(--accent)]">
							01
						</span>

						<p class="text-xs uppercase tracking-[0.2em] text-[var(--text-dim)]">
							Overview
						</p>
					</div>
				</div>

				<div>
					<h2 class="max-w-3xl text-3xl font-medium leading-tight tracking-[-0.03em] text-[var(--text)] md:text-5xl">
						Combining Web Development and Machine Learning.
					</h2>

					<div class="mt-8 max-w-3xl space-y-5 leading-7 text-[var(--text-muted)]">
						<p>
							Prediksi Kualitas AMDK merupakan aplikasi web yang dikembangkan
							sebagai project akademik untuk menerapkan algoritma Support Vector
							Machine dalam proses prediksi kualitas Air Minum Dalam Kemasan.
						</p>

						<p>
							Project ini menggabungkan pengembangan web dan machine learning.
							Laravel digunakan sebagai aplikasi web utama, sementara Flask
							berbasis Python digunakan sebagai service untuk menjalankan proses
							prediksi menggunakan model Support Vector Machine.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Architecture -->
		<section class="mx-auto max-w-6xl border-t border-[var(--border)] px-6 py-24 md:px-8 md:py-32">
			<div class="grid gap-12 md:grid-cols-[0.7fr_2fr] md:gap-16">
				<div>
					<div class="flex items-center gap-4">
						<span class="border border-[var(--accent)] px-2.5 py-1 font-mono text-[11px] text-[var(--accent)]">
							02
						</span>

						<p class="text-xs uppercase tracking-[0.2em] text-[var(--text-dim)]">
							Architecture
						</p>
					</div>
				</div>

				<div>
					<h2 class="max-w-3xl text-3xl font-medium leading-tight tracking-[-0.03em] text-[var(--text)] md:text-5xl">
						Web Application Connected to a Machine Learning Service.
					</h2>
					<p class="mt-6 max-w-2xl leading-7 text-[var(--text-muted)]">
						Aplikasi web dikembangkan menggunakan Laravel dan Blade, sementara
						proses prediksi ditangani oleh service Flask berbasis Python yang
						menjalankan model Support Vector Machine.
					</p>

					<div class="mt-14 border-t border-[var(--border)]">
						<!-- Web Application -->
						<div class="grid gap-5 border-b border-[var(--border)] py-7 sm:grid-cols-[120px_1fr_auto]">
							<span class="font-mono text-xs text-[var(--text-dim)]">01</span>

							<div>
								<p class="text-xs uppercase tracking-widest text-[var(--text-dim)]">
									Web Application
								</p>

								<h3 class="mt-2 text-xl text-[var(--text)]">
									Laravel / Blade / PHP
								</h3>

								<p class="mt-2 text-sm text-[var(--text-dim)]">Tailwind CSS</p>
							</div>

							<span class="text-sm text-[var(--accent)]">API ↓</span>
						</div>

						<!-- Machine Learning API -->
						<div class="grid gap-5 border-b border-[var(--border)] py-7 sm:grid-cols-[120px_1fr_auto]">
							<span class="font-mono text-xs text-[var(--text-dim)]">02</span>

							<div>
								<p class="text-xs uppercase tracking-widest text-[var(--text-dim)]">
									Prediction API
								</p>

								<h3 class="mt-2 text-xl text-[var(--text)]">Flask / Python</h3>
							</div>

							<span class="text-sm text-[var(--accent)]">↓</span>
						</div>

						<!-- Model -->
						<div class="grid gap-5 border-b border-[var(--border)] py-7 sm:grid-cols-[120px_1fr]">
							<span class="font-mono text-xs text-[var(--text-dim)]">03</span>

							<div>
								<p class="text-xs uppercase tracking-widest text-[var(--text-dim)]">
									Machine Learning Model
								</p>

								<h3 class="mt-2 text-xl text-[var(--text)]">
									Support Vector Machine
								</h3>
							</div>
						</div>
					</div>

					<!-- Prediction pipeline -->
					<div class="mt-12">
						<p class="text-xs uppercase tracking-[0.18em] text-[var(--text-dim)]">
							Prediction Pipeline
						</p>

						<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
							<span class="border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-sm text-[var(--text-muted)]">
								Input Data
							</span>

							<span class="text-[var(--accent)]">→</span>

							<span class="border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-sm text-[var(--text-muted)]">
								Laravel
							</span>

							<span class="text-[var(--accent)]">→</span>

							<span class="border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-sm text-[var(--text-muted)]">
								Flask API
							</span>

							<span class="text-[var(--accent)]">→</span>

							<span class="border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-sm text-[var(--text-muted)]">
								SVM
							</span>

							<span class="text-[var(--accent)]">→</span>

							<span class="border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-sm text-[var(--text-muted)]">
								Prediction Result
							</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Key Features -->
		<section class="mx-auto max-w-6xl border-t border-[var(--border)] px-6 py-24 md:px-8 md:py-32">
			<div class="grid gap-12 md:grid-cols-[0.7fr_2fr] md:gap-16">
				<div>
					<div class="flex items-center gap-4">
						<span class="border border-[var(--accent)] px-2.5 py-1 font-mono text-[11px] text-[var(--accent)]">
							03
						</span>

						<p class="text-xs uppercase tracking-[0.2em] text-[var(--text-dim)]">
							Key Features
						</p>
					</div>
				</div>

				<div>
					<div class="border-t border-[var(--border)]">
						<div class="group grid gap-5 border-b border-[var(--border)] py-8 sm:grid-cols-[80px_1fr]">
							<span class="font-mono text-xs text-[var(--text-dim)] transition group-hover:text-[var(--accent)]">
								01
							</span>

							<div>
								<h3 class="text-xl text-[var(--text)] transition group-hover:text-[var(--accent)]">
									Quality Prediction
								</h3>

								<p class="mt-3 max-w-2xl leading-7 text-[var(--text-muted)]">
									Aplikasi menyediakan proses prediksi kualitas AMDK berdasarkan
									data yang dimasukkan oleh pengguna.
								</p>
							</div>
						</div>

						<div class="group grid gap-5 border-b border-[var(--border)] py-8 sm:grid-cols-[80px_1fr]">
							<span class="font-mono text-xs text-[var(--text-dim)] transition group-hover:text-[var(--accent)]">
								02
							</span>

							<div>
								<h3 class="text-xl text-[var(--text)] transition group-hover:text-[var(--accent)]">
									SVM-Based Prediction
								</h3>

								<p class="mt-3 max-w-2xl leading-7 text-[var(--text-muted)]">
									Proses prediksi menggunakan model Support Vector Machine yang
									dijalankan melalui service berbasis Python dan Flask.
								</p>
							</div>
						</div>

						<div class="group grid gap-5 border-b border-[var(--border)] py-8 sm:grid-cols-[80px_1fr]">
							<span class="font-mono text-xs text-[var(--text-dim)] transition group-hover:text-[var(--accent)]">
								03
							</span>

							<div>
								<h3 class="text-xl text-[var(--text)] transition group-hover:text-[var(--accent)]">
									Machine Learning Integration
								</h3>

								<p class="mt-3 max-w-2xl leading-7 text-[var(--text-muted)]">
									Laravel terintegrasi dengan service Flask untuk mengirim data
									prediksi dan menerima hasil klasifikasi dari model SVM.
								</p>
							</div>
						</div>

						<div class="group grid gap-5 border-b border-[var(--border)] py-8 sm:grid-cols-[80px_1fr]">
							<span class="font-mono text-xs text-[var(--text-dim)] transition group-hover:text-[var(--accent)]">
								04
							</span>

							<div>
								<h3 class="text-xl text-[var(--text)] transition group-hover:text-[var(--accent)]">
									Web Interface
								</h3>

								<p class="mt-3 max-w-2xl leading-7 text-[var(--text-muted)]">
									Antarmuka aplikasi web dikembangkan dan ditata menggunakan
									Tailwind CSS.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Screenshots -->
		<section class="mx-auto max-w-6xl border-t border-[var(--border)] px-6 py-24 md:px-8 md:py-32">
			<div class="grid gap-12 md:grid-cols-[0.7fr_2fr] md:gap-16">
				<div>
					<div class="flex items-center gap-4">
						<span class="border border-[var(--accent)] px-2.5 py-1 font-mono text-[11px] text-[var(--accent)]">
							04
						</span>

						<p class="text-xs uppercase tracking-[0.2em] text-[var(--text-dim)]">
							Screenshots
						</p>
					</div>
				</div>

				<div>
					<h2 class="max-w-3xl text-3xl font-medium tracking-[-0.03em] text-[var(--text)] md:text-5xl">
						A Closer Look at the Application.
					</h2>

					<p class="mt-5 max-w-2xl leading-7 text-[var(--text-muted)]">
						Beberapa tampilan aplikasi yang menunjukkan antarmuka web dan proses
						prediksi kualitas AMDK.
					</p>
				</div>
			</div>

			<!-- Screenshot grid -->
			<div class="mx-auto mt-16 grid max-w-5xl gap-6 md:grid-cols-2">
				<!-- Screenshot 01 -->
				<figure class="border border-[var(--border)] bg-[var(--surface)] transition duration-300 hover:border-[var(--text-dim)]">
					<button
						type="button"
						class="group/preview flex aspect-[16/9] w-full cursor-zoom-in items-center justify-center overflow-hidden bg-[var(--surface-soft)] p-4"
						data-image-preview
						data-src={asset('images/amdk/dashboard.png')}
						data-alt="Dashboard aplikasi Prediksi Kualitas AMDK"
						aria-label="Perbesar screenshot dashboard AMDK"
					>
						<img
							src={asset('images/amdk/dashboard.png')}
							alt="Dashboard aplikasi Prediksi Kualitas AMDK"
							class="max-h-full max-w-full object-contain transition-transform duration-500 ease-out group-hover/preview:scale-[1.04]"
						/>
					</button>

					<figcaption class="border-t border-[var(--border)] p-5">
						<div class="flex gap-4">
							<span class="pt-0.5 font-mono text-[10px] text-[var(--accent)]">
								01
							</span>

							<div>
								<p class="text-sm text-[var(--text)]">Dashboard</p>

								<p class="mt-1 text-xs leading-5 text-[var(--text-dim)]">
									Halaman utama yang menampilkan ringkasan informasi dalam
									aplikasi.
								</p>
							</div>
						</div>
					</figcaption>
				</figure>

				<!-- Screenshot 02 -->
				<figure class="border border-[var(--border)] bg-[var(--surface)] transition duration-300 hover:border-[var(--text-dim)]">
					<button
						type="button"
						class="group/preview flex aspect-[16/9] w-full cursor-zoom-in items-center justify-center overflow-hidden bg-[var(--surface-soft)] p-4"
						data-image-preview
						data-src={asset('images/amdk/prediksi-page.png')}
						data-alt="Halaman prediksi kualitas AMDK"
						aria-label="Perbesar screenshot halaman prediksi AMDK"
					>
						<img
							src={asset('images/amdk/prediksi-page.png')}
							alt="Halaman prediksi kualitas AMDK"
							class="max-h-full max-w-full object-contain transition-transform duration-500 ease-out group-hover/preview:scale-[1.04]"
						/>
					</button>

					<figcaption class="border-t border-[var(--border)] p-5">
						<div class="flex gap-4">
							<span class="pt-0.5 font-mono text-[10px] text-[var(--accent)]">
								02
							</span>

							<div>
								<p class="text-sm text-[var(--text)]">Prediction Page</p>

								<p class="mt-1 text-xs leading-5 text-[var(--text-dim)]">
									Halaman untuk memasukkan data dan melakukan prediksi kualitas
									AMDK menggunakan model SVM.
								</p>
							</div>
						</div>
					</figcaption>
				</figure>

				<!-- Screenshot 03 -->
				<figure class="border border-[var(--border)] bg-[var(--surface)] transition duration-300 hover:border-[var(--text-dim)]">
					<button
						type="button"
						class="group/preview flex aspect-[16/9] w-full cursor-zoom-in items-center justify-center overflow-hidden bg-[var(--surface-soft)] p-4"
						data-image-preview
						data-src={asset('images/amdk/import-page.png')}
						data-alt="Halaman import data AMDK"
						aria-label="Perbesar screenshot halaman import data AMDK"
					>
						<img
							src={asset('images/amdk/import-page.png')}
							alt="Halaman import data AMDK"
							class="max-h-full max-w-full object-contain transition-transform duration-500 ease-out group-hover/preview:scale-[1.04]"
						/>
					</button>

					<figcaption class="border-t border-[var(--border)] p-5">
						<div class="flex gap-4">
							<span class="pt-0.5 font-mono text-[10px] text-[var(--accent)]">
								03
							</span>

							<div>
								<p class="text-sm text-[var(--text)]">Import Page</p>

								<p class="mt-1 text-xs leading-5 text-[var(--text-dim)]">
									Halaman untuk mengimpor data ke dalam aplikasi sebagai bagian
									dari proses pengelolaan data.
								</p>
							</div>
						</div>
					</figcaption>
				</figure>

				<!-- Screenshot 04 -->
				<figure class="border border-[var(--border)] bg-[var(--surface)] transition duration-300 hover:border-[var(--text-dim)]">
					<button
						type="button"
						class="group/preview flex aspect-[16/9] w-full cursor-zoom-in items-center justify-center overflow-hidden bg-[var(--surface-soft)] p-4"
						data-image-preview
						data-src={asset('images/amdk/riwayat-page.png')}
						data-alt="Halaman riwayat prediksi kualitas AMDK"
						aria-label="Perbesar screenshot halaman riwayat AMDK"
					>
						<img
							src={asset('images/amdk/riwayat-page.png')}
							alt="Halaman riwayat prediksi kualitas AMDK"
							class="max-h-full max-w-full object-contain transition-transform duration-500 ease-out group-hover/preview:scale-[1.04]"
						/>
					</button>

					<figcaption class="border-t border-[var(--border)] p-5">
						<div class="flex gap-4">
							<span class="pt-0.5 font-mono text-[10px] text-[var(--accent)]">
								04
							</span>

							<div>
								<p class="text-sm text-[var(--text)]">Prediction History</p>

								<p class="mt-1 text-xs leading-5 text-[var(--text-dim)]">
									Halaman yang menampilkan riwayat hasil prediksi yang telah
									dilakukan melalui aplikasi.
								</p>
							</div>
						</div>
					</figcaption>
				</figure>
			</div>
			<dialog
				id="image-lightbox"
				class="m-auto max-h-[92vh] max-w-[94vw] bg-transparent p-0 backdrop:bg-black/80"
			>
				<div class="relative border border-[var(--border)] bg-[var(--surface)] p-3 md:p-5">
					<button
						type="button"
						id="close-lightbox"
						class="absolute right-3 top-3 z-20 flex h-10 w-10 items-center justify-center border border-[var(--border)] bg-[var(--bg)] text-xl text-[var(--text-muted)] transition hover:border-[var(--accent)] hover:text-[var(--text)]"
						aria-label="Tutup preview gambar"
					>
						×
					</button>

					<img
						id="lightbox-image"
						src=""
						alt=""
						class="block max-h-[85vh] max-w-[88vw] object-contain"
					/>
				</div>
			</dialog>
		</section>

		<!-- Source Code -->
		<section class="mx-auto max-w-6xl border-t border-[var(--border)] px-6 py-24 md:px-8 md:py-32">
